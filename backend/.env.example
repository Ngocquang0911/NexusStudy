PORT=5000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
#mongodb://127.0.0.1:27017/nexus_study
# Optional: DNS resolvers for Node.js SRV lookups if the system DNS fails.
# MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1
JWT_SECRET=replace-with-a-random-secret-before-running
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Gemini alternative: use a Gemini API key as AI_API_KEY and uncomment these two lines.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-3.5-flash-lite
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_FROM=your-email@example.com
SMTP_PASSWORD=
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET=
